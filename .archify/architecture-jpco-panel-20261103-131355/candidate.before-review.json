  "cards": [
    {
      "dot": "cyan",
      "title": "Browser Path",
      "items": [
        "Next.js 16 App Router PWA with a service worker and manifest",
        "Client SDK signs users in and keeps a persistent Firestore cache",
        "Task attachments upload browser-to-Storage; rules gate direct Firestore access"
      ]
    },
    {
      "dot": "emerald",
      "title": "Server Path",
      "items": [
        "Route handlers validate payloads with Zod and wrap auth per role",
        "server-auth verifies the ID token and caches the user profile for 5 minutes",
        "Notifications write Firestore history and send FCM directly from routes"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Platform",
      "items": [
        "Roles are admin, manager, employee, enforced in rules and route wrappers",
        "Credential vault secrets are AES-256-CBC encrypted with ENCRYPTION_KEY",
        "Callable Cloud Functions sync role changes into Auth custom claims"
      ]
    }
  ]
